<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 全面禁止明文 HTTP 傳輸，僅信任系統憑證授權機構 (System CA) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
